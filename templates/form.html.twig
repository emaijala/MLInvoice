{% if data.deleted %}
  <div class="form_container alert alert-warning deleted-record-msg">
    <div class="message">{{ 'DeletedRecord'|trans }}</div>
  </div>
{% endif %}


<div id="popup_dlg" class="modal" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">-</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
      </div>
      <div class="modal-body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
{% if formConfig.popupHTML %}
  {{ formConfig.popupHTML }}
{% endif %}

<div class="form_container">
  {% include 'form-buttons.html.twig' with { 'top': true } %}

  {% if (id and formConfig.type == 'invoice_template') %}
    {% if data.next_interval_date and data.interval_type %}
      {% set alertClass = ' hidden' %}
    {% else %}
      {% set alertClass = '' %}
    {% endif %}

    <div class="alert alert-warning message js-recurrence-alert{{ alertClass }}" role="alert">
        {{ 'RecurrenceOrNextInvoiceDateNotSet'|trans }}
    </div>
  {% endif %}

  {% if data.next_interval_date and formatDate(data.next_interval_date, 'Y-m-d') <= formatDate(null, 'Y-m-d') %}
    <div class="alert alert-warning message" role="alert">
      {{ formConfig.type == 'invoice' ? 'CreateCopyForNextInvoice'|trans : 'RecurringInvoiceDueForProcessing'|trans }}
    </div>
  {% endif %}

  <div class="form">
    <form method="post" name="form" id="form"{{ dataAttributes(formConfig.dataAttrs) }}>
      <input type="hidden" name="action" value="">
      <input type="hidden" name="redirect" id="redirect" value="">
      <input type="hidden" id="record_id" name="id" value="{{ data.id|escape }}">
      {% if formConfig.type == 'invoice' or formConfig.type == 'offer' or formConfig.type == 'invoice_template' %}
        <input type="hidden" id="invoice_vatless" name="invoice_vatless" value="0">
      {% endif %}
      {% for field in formConfig.hiddenFields %}
        <input type="hidden" id="{{ field.name|escape }}" name="{{ field.name|escape }}" value="{{ data.(field.name)|escape }}">
      {% endfor %}

      {% set prevPosition = false %}
      {% set formMode = ((not writeAccess) or formConfig.readOnly) ? 'READONLY' : '' %}
      {% for field in formConfig.fields %}
        {% set style = field.style ? field.style : '' %}
        {% set fieldClass = '' %}
        {% if field.hidden %}
          {% set style = style ~ ' hidden' %}
          {% set fieldClass = ' hidden' %}
        {% endif %}
        {% set fieldMode = field.readOnly ? 'READONLY' : (formReadOnly ? 'READONLY' : 'MODIFY') %}
        {% if field.type == 'HEADING' %}
          <div class="sublabel{{ style }} mt-4"{% if field.name %} id="{{ field.name|e }}"{% endif %}>
            <h2>{{ field.label|trans }}</h2>
          </div>
        {% elseif field.type == 'LABEL' %}
          <div class="sublabel{{ style }}"{% if field.name %} id="{{ field.name|e }}"{% endif %}>
            {{ field.label|trans }}
          </div>
        {% endif %}

        {% if field.position == 0 or field.position <= prevPosition %}
          <div class="clear-row"></div>
          {% set prevPosition = 0 %}
        {% endif %}

        {% set contentsClasses = field.type|lower|e ~ ' ' ~ field.style ~ (attached_elem in field ? ' attached' : '') %}
        {% if (not id) and field.type in ['BUTTON', 'JSBUTTON', 'IMAGE', 'DROPDOWNMENU'] %}
          <div class="label {{ style }}">&nbsp;</div>
        {% elseif field.type in ['BUTTON', 'JSBUTTON', 'DROPDOWNMENU'] %}
          <div class="form-field button{{ fieldClass }}">
            {{ htmlFormElement(
              field.name,
              field.type,
              data.(field.name) ?? '',
              field.style,
              field.listquery,
              fieldMode,
              field.parent_key,
              field.label,
              [],
              field.elem_attributes,
              field.options)
            }}
          </div>
        {% elseif field.type == 'IMAGE' %}
          <div class="field image<?php echo $fieldClass?>">
            <div class="field-contents <?php echo $contentsClasses?>">
              {{ htmlFormElement(
                field.name,
                field.type,
                data.(field.name) ?? '',
                field.style,
                field.listquery,
                fieldMode,
                field.parent_key,
                field.label,
                [],
                field.elem_attributes,
                field.options)
              }}
            </div>
          </div>
        {% else %}
          <div class="field{{ fieldClass }}">
            {% set value = data.(field.name) %}
            {% if field.style == 'measurement' %}
              {% set value = value ? roundNumber(value, 2) : '' %}
            {% endif %}
            {% if elem.tyle == 'AREA' %}
              <label for="{{ field.name|e }}" class="toplabel{{ style }}">
                {{ field.label|trans }}
              </label>
            {% else %}
              <label id="{{ field.name|e }}_label" for="{{ field.name|e }}" class="label {{ style }}"{% if field.title %} title="{{ field.title|trans }}"{% endif %}>
                {{ field.label|trans }}
              </label>
            {% endif %}
            <div class="field-contents {{ contentsClasses }}">
              {{ htmlFormElement(
                field.name,
                field.type,
                value,
                field.style,
                field.list ?? field.listquery,
                fieldMode,
                field.parent_key,
                '',
                [],
                field.elem_attributes ?? '',
                field.options)
              }}
              {% if field.attached_elem and field.type != 'AREA' %}
                {{ field.attached_elem }}
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% set prevPosition = field.position ?: 0 %}
        {% if prevPosition == 0 %}
          {% set prevPosition = 255 %}
        {% endif %}
      {% endfor %}
    </form>
    {% if formConfig.childFormField %}
      {% include 'child-form.twig.html' with { field: formConfig.childFormField, childFormConfig: formConfig.childFormConfig, defaults: childFormDefaults } %}
    {% endif %}
    {% if formConfig.type == 'product' %}
      {# Special case for product: show stock balance change log #}
      <div class="card p-2 mb-2 iform clearfix" id="stock_balance_log">
        <h2>
          {{ 'StockBalanceUpdates'|trans }}
        </h2>
        <table id="stock_balance_change_log" class="table">
          <tr>
            <th class="medium">{{ 'HeaderChangeLogDateTime'|trans }}</th>
            <th class="medium">{{ 'HeaderChangeLogUser'|trans }}</th>
            <th class="small">{{ 'HeaderChangeLogAmount'|trans }}</th>
            <th class="long">{{ 'HeaderChangeLogDescription'|trans }}</th>
          </tr>
        </table>
      </div>
    {% endif %}
  </div>
</div>

<script>
$(document).ready(function() {
  {% if formConfig.type == 'product' %}
    MLInvoice.Form.updateStockBalanceLog();
  {% endif %}

  MLInvoice.Form.initForm(
    {{ formConfig.js.mainFormConfig|json_encode }},
    {{ formConfig.js.subFormConfig|json_encode }},
    {{ formConfig.js.listItems|json_encode }},
    {{ csrf()|json_encode }}
  );
  {% if formConfig.js.subFormConfig and id %}
    MLInvoice.Form.initRows(
      function initRowsDone() {
        {% if newLocation %}
          window.location='{{ newLocation }}';
        {% endif %}
      }
    );
  {% elseif newLocation %}
    window.location='{{ newLocation }}';
  {% endif %}

  {% if openWindow %}
    window.open('{{ openWindow }}');
  {% endif %}
});
</script>

{% include 'form-buttons.html.twig' with { 'top': false } %}

{% if formConfig.addressAutocomplete %}
<script>
  $(document).ready(function() {
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src  = "https://maps.googleapis.com/maps/api/js?sensor=false&libraries=places&callback=gmapsready";
    window.gmapsready = function() {
      MLInvoice.Form.initAddressAutocomplete('');
      MLInvoice.Form.initAddressAutocomplete('quick_');
    };
    $('head').append(s);
  });
</script>
{% endif %}

{% if 'invoice' == formConfig.type %}
  <div id="quick_add_company" class="modal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">{{ 'NewClient'|trans }}</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="medium_label">{{ 'ClientName'|trans }}</div>
          <div class="field"><input type="text" id="quick_name" class='form-control medium'></div>
          <div class="medium_label">{{ 'ClientVATID'|trans }}</div>
          <div class="field"><input type="text" id="quick_vat_id" class='form-control medium'></div>
          <div class="medium_label">{{ 'Email'|trans }}</div>
          <div class="field"><input type="text" id="quick_email" class='form-control medium'></div>
          <div class="medium_label">{{ 'Phone'|trans }}</div>
          <div class="field"><input type="text" id="quick_phone" class='form-control medium'></div>
          <div class="medium_label">{{ 'StreetAddr'|trans }}</div>
          <div class="field"><input type="text" id="quick_street_address" class='form-control medium'></div>
          <div class="medium_label">{{ 'ZipCode'|trans }}</div>
          <div class="field"><input type="text" id="quick_zip_code" class='form-control medium'></div>
          <div class="medium_label">{{ 'City'|trans }}</div>
          <div class="field"><input type="text" id="quick_city" class='form-control medium'></div>
          <div class="medium_label">{{ 'Country'|trans }}</div>
          <div class="field"><input type="text" id="quick_country" class='form-control medium'></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
          <button type="button" class="btn btn-primary" data-save-company>{{ 'Save'|trans }}</button>
        </div>
      </div>
    </div>
  </div>

  <div id="add_partial_payment" class="modal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">{{ 'PartialPayment'|trans }}</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="medium_label">{{ 'PaymentAmount'|trans }}</div>
          <div class="field"><input type="text" id="add_partial_payment_amount" class="form-control medium"></div>
          <div class="medium_label">{{ 'PayDate'|trans }}</div>
          <div class="field"><input type="date" id="add_partial_payment_date" class="form-control date"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
          <button type="button" class="btn btn-primary" data-save-partial-payment>{{ 'Save'|trans }}</button>
        </div>
      </div>
    </div>
  </div>
{% elseif 'product' == formConfig.type %}
  <div id="update_stock_balance" class="modal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">{{ 'PartialPayment'|trans }}</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="medium_label">{{ 'StockBalanceChange'|trans }}</div> <div class="field">
          <input type="text" id="stock_balance_change" class='form-control short'></div>
          <div class="medium_label">{{ 'StockBalanceChangeDescription'|trans }}</div>
          <div class="field"><textarea id="stock_balance_change_desc" class="form-control large"></textarea></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
          <button type="button" class="btn btn-primary" data-save-stock-balance-change>{{ 'Save'|trans }}</button>
        </div>
      </div>
    </div>
  </div>
{% endif %}
