{% if data.deleted %}
  <div class="form_container alert alert-warning deleted-record-msg">
    <div class="message">{{ 'DeletedRecord'|trans }}</div>
  </div>
{% endif %}


<div id="popup_dlg" class="modal" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">-</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
      </div>
      <div class="modal-body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
{% if formConfig.popupHTML %}
  {{ formConfig.popupHTML }}
{% endif %}

<div class="form_container">
  {% include 'form-buttons.html.twig' with { 'top': true } %}

  {% if (id and formConfig.type == 'invoice_template') %}
    {% if data.next_interval_date and data.interval_type %}
      {% set alertClass = ' hidden' %}
    {% else %}
      {% set alertClass = '' %}
    {% endif %}

    <div class="alert alert-warning message js-recurrence-alert{{ alertClass }}" role="alert">
        {{ 'RecurrenceOrNextInvoiceDateNotSet'|trans }}
    </div>
  {% endif %}

  {% if data.next_interval_date and formatDate(data.next_interval_date, 'Y-m-d') <= formatDate(null, 'Y-m-d') %}
    <div class="alert alert-warning message" role="alert">
      {{ formConfig.type == 'invoice' ? 'CreateCopyForNextInvoice'|trans : 'RecurringInvoiceDueForProcessing'|trans }}
    </div>
  {% endif %}

  <div class="form">
    <form method="post" name="form" id="form"{{ dataAttributes(formConfig.dataAttrs) }}>
      <input type="hidden" name="action" value="">
      <input type="hidden" name="redirect" id="redirect" value="">
      <input type="hidden" id="record_id" name="id" value="{{ data.id|escape }}">
      {% if formConfig.type == 'invoice' or formConfig.type == 'offer' or formConfig.type == 'invoice_template' %}
        <input type="hidden" id="invoice_vatless" name="invoice_vatless" value="0">
      {% endif %}
      {% for field in formConfig.hiddenFields %}
        <input type="hidden" id="{{ field.name|escape }}" name="{{ field.name|escape }}" value="{{ data.(field.name)|escape }}">
      {% endfor %}

      {% set childFormConfig = false %}
      {% set prevPosition = false %}
      {% set formMode = ((not writeAccess) or formConfig.readOnly) ? 'READONLY' : '' %}
      {% for field in formConfig.fields %}
        {% set style = field.style ? field.style : '' %}
        {% set fieldClass = '' %}
        {% if field.hidden %}
          {% set style = style ~ ' hidden' %}
          {% set fieldClass = ' hidden' %}
        {% endif %}
        {% set fieldMode = field.readOnly ? 'READONLY' : formReadOnly %}
        {% if field.type == 'HEADING' %}
          <div class="sublabel{{ style }} mt-4"{% if field.name %} id="{{ field.name|e }}"{% endif %}>
            <h2>{{ field.label|trans }}</h2>
          </div>
        {% elseif field.type == 'LABEL' %}
          <div class="sublabel{{ style }}"{% if field.name %} id="{{ field.name|e }}"{% endif %}>
            {{ field.label|trans }}
          </div>
        {% endif %}

        {% if field.position == 0 or field.position <= prevPosition %}
          <div class="clear-row"></div>
          {% set prevPosition = 0 %}
        {% endif %}

        {% set contentsClasses = field.type|lower|e ~ ' ' ~ field.style ~ (attached_elem in field ? ' attached' : '') %}
        {% if not id and field.type in ['BUTTON', 'JSBUTTON', 'IMAGE', 'DROPDOWNMENU'] %}
          <div class="label{{ style }}">&nbsp;</div>
        {% elseif field.type in ['BUTTON', 'JSBUTTON', 'DROPDOWNMENU'] %}
          <div class="form-field button{{ fieldClass }}">
            {{ htmlFormElement(
              field.name,
              field.type,
              data.(field.name) ?? '',
              field.style,
              field.listquery,
              fieldMode,
              field.parent_key,
              field.label,
              [],
              field.elem_attributes,
              field.options)
            }}
          </div>
        {% elseif field.type == 'IMAGE' %}
          <div class="field image<?php echo $fieldClass?>">
            <div class="field-contents <?php echo $contentsClasses?>">
              {{ htmlFormElement(
                field.name,
                field.type,
                data.(field.name) ?? '',
                field.style,
                field.listquery,
                fieldMode,
                field.parent_key,
                field.label,
                [],
                field.elem_attributes,
                field.options)
              }}
            </div>
          </div>
        {% elseif field.type == 'IFORM' %}
          TODO IFORM
          </form>
        echo "      </form>\n";
        $childFormConfig = getFormConfig($elem['name'], $strFunc, null, $intKeyValue);
        createIForm(
            $formConfig, $childFormConfig, $elem,
            $intKeyValue ?? 0, $intKeyValue ? false : true,
            $strForm,
            $strFunc
        );
        break;

        {% else %}
          <div class="field{{ fieldClass }}">
            {% set value = data.(field.name) %}
            {% if field.style == 'measurement' %}
              {% set value = value ? roundNumber(value, 2) : '' %}
            {% endif %}
            {% if elem.tyle == 'AREA' %}
              <label for="{{ field.name|e }}" class="toplabel{{ style }}">
                {{ field.label|trans }}
              </label>
            {% else %}
              <label id="{{ field.name|e }}_label" for="{{ field.name|e }}" class="label{{ style }}"{% if field.title %} title="{{ field.title|trans }}"{% endif %}>
                {{ field.label|trans }}
              </label>
            {% endif %}
            <div class="field-contents {{ contentsClasses }}">
              {{ htmlFormElement(
                field.name,
                field.type,
                value,
                field.style,
                field.listquery,
                fieldMode,
                field.parent_key,
                '',
                [],
                field.elem_attributes ?? '',
                field.options)
              }}
              {% if field.attached_elem and field.type != 'AREA' %}
                {{ field.attached_elem }}
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% set prevPosition = field.position ?: 0 %}
        {% if prevPosition == 0 %}
          {% set prevPosition = 255 %}
        {% endif %}
      {% endfor %}
}
if (!$childFormConfig) {
    echo "      </form>\n";
}
